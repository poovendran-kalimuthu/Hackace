# Local Desktop Storage Configuration (Self-Contained SQLite, Zero-Dependency)
DB_TYPE=sqlite
SQLITE_DB_NAME=platform_meta.db

# Optional MySQL Configuration (if DB_TYPE=mysql is set)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=docucraft_db

# Local Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=desktop
LOG_LEVEL=INFO
