{
  "id": "book",
  "profile_name": "Book Publisher",
  "profile_version": "1.0",
  "document_type": "book",

  "page": {
    "size": "A4",
    "orientation": "portrait",

    "margins": {
      "top": 1.52,
      "bottom": 1.52,
      "left": 1.97,
      "right": 1.96,
      "unit": "cm"
    },

    "gutter": {
      "position": "left"
    }
  },

  "layout": {
    "columns": 1
  },

  "default_text": {
    "font": "Times New Roman",
    "font_size": 12,
    "font_size_unit": "pt",
    "color": "black",
    "alignment": "justify",
    "line_spacing": 1.5,
    "first_line_indent": 1.27,
    "indent_unit": "cm"
  },

  "elements": {

    "TITLE": {
      "font": "Times New Roman",
      "color": "black"
    },

    "BODY": {
      "font": "Times New Roman",
      "font_size": 12,
      "font_size_unit": "pt",
      "color": "black",
      "alignment": "justify",
      "line_spacing": 1.5,
      "first_line_indent": 1.27,
      "indent_unit": "cm"
    },

    "HEADING_1": {
      "font": "Times New Roman",
      "font_size": 16,
      "font_size_unit": "pt",
      "bold": true,
      "color": "black"
    },

    "SUBHEADING": {
      "font": "Times New Roman",
      "font_size": 12,
      "font_size_unit": "pt",
      "bold": true,
      "color": "black"
    }
  },

  "validation": {
    "check_single_column": true,
    "check_font": true,
    "check_font_color": true,
    "check_body_font_size": true,
    "check_alignment": true,
    "check_line_spacing": true,
    "check_first_line_indent": true,
    "check_margins": true,
    "check_gutter": true,
    "check_heading_1": true,
    "check_subheading": true
  }
}