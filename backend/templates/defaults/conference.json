{
  "id": "conference",
  "profile_name": "Conference Paper",
  "profile_version": "1.0",
  "document_type": "conference_paper",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 0.75,
      "bottom": 0.75,
      "left": 0.75,
      "right": 0.75,
      "unit": "inch"
    },
    "gutter": {
      "position": "none"
    }
  },
  "layout": {
    "columns": 2,
    "column_gap": 0.25,
    "gap_unit": "inch"
  },
  "default_text": {
    "font": "Times New Roman",
    "font_size": 10.0,
    "font_size_unit": "pt",
    "color": "#000000",
    "alignment": "JUSTIFY",
    "line_spacing": 1.05,
    "first_line_indent": 0.16,
    "indent_unit": "inch"
  },
  "elements": {
    "TITLE": {
      "font": "Times New Roman",
      "font_size": 24.0,
      "font_size_unit": "pt",
      "bold": true,
      "italic": false,
      "alignment": "CENTER",
      "space_before": 12,
      "space_after": 8,
      "span_columns": true
    },
    "AUTHOR": {
      "font": "Times New Roman",
      "font_size": 11.0,
      "font_size_unit": "pt",
      "bold": false,
      "italic": false,
      "alignment": "CENTER",
      "space_before": 4,
      "space_after": 2,
      "span_columns": true
    },
    "AFFILIATION": {
      "font": "Times New Roman",
      "font_size": 9.0,
      "font_size_unit": "pt",
      "bold": false,
      "italic": true,
      "alignment": "CENTER",
      "space_before": 0,
      "space_after": 14,
      "span_columns": true
    },
    "ABSTRACT": {
      "font": "Times New Roman",
      "font_size": 9.0,
      "font_size_unit": "pt",
      "alignment": "JUSTIFY",
      "line_spacing": 1.05,
      "space_before": 8,
      "space_after": 8,
      "first_line_indent": 0.0,
      "span_columns": true
    },
    "KEYWORDS": {
      "font": "Times New Roman",
      "font_size": 9.0,
      "font_size_unit": "pt",
      "italic": true,
      "alignment": "JUSTIFY",
      "space_before": 0,
      "space_after": 12,
      "span_columns": true
    },
    "HEADING_1": {
      "font": "Times New Roman",
      "font_size": 10.0,
      "font_size_unit": "pt",
      "bold": true,
      "alignment": "CENTER",
      "space_before": 10,
      "space_after": 4
    },
    "HEADING_2": {
      "font": "Times New Roman",
      "font_size": 10.0,
      "font_size_unit": "pt",
      "bold": true,
      "italic": true,
      "alignment": "LEFT",
      "space_before": 8,
      "space_after": 3
    },
    "HEADING_3": {
      "font": "Times New Roman",
      "font_size": 9.5,
      "font_size_unit": "pt",
      "italic": true,
      "alignment": "LEFT",
      "space_before": 6,
      "space_after": 2
    },
    "BODY": {
      "font": "Times New Roman",
      "font_size": 10.0,
      "font_size_unit": "pt",
      "alignment": "JUSTIFY",
      "line_spacing": 1.05,
      "first_line_indent": 0.16,
      "indent_unit": "inch",
      "space_before": 0,
      "space_after": 0
    },
    "TABLE": {
      "font": "Times New Roman",
      "font_size": 9.0,
      "font_size_unit": "pt",
      "alignment": "CENTER"
    },
    "CAPTION": {
      "font": "Times New Roman",
      "font_size": 9.0,
      "font_size_unit": "pt",
      "bold": true,
      "alignment": "CENTER",
      "space_before": 8,
      "space_after": 3
    },
    "REFERENCE": {
      "font": "Times New Roman",
      "font_size": 8.5,
      "font_size_unit": "pt",
      "alignment": "LEFT",
      "line_spacing": 1.0,
      "hanging_indent": 0.2,
      "indent_unit": "inch",
      "space_after": 3
    }
  },
  "validation": {
    "check_page_layout": true,
    "check_columns": true,
    "check_font": true,
    "check_font_size": true,
    "check_alignment": true,
    "check_line_spacing": true,
    "check_heading_hierarchy": true,
    "check_figures": true,
    "check_tables": true,
    "check_references": true
  }
}
