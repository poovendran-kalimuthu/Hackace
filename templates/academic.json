{
  "id": "academic",
  "profile_name": "Academic Research Paper",
  "profile_version": "1.0",
  "document_type": "academic_report",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 1.0,
      "bottom": 1.0,
      "left": 1.0,
      "right": 1.0,
      "unit": "inch"
    },
    "gutter": {
      "position": "none"
    }
  },
  "layout": {
    "columns": 1,
    "column_gap": 0.25,
    "gap_unit": "inch"
  },
  "default_text": {
    "font": "Times New Roman",
    "font_size": 11.0,
    "font_size_unit": "pt",
    "color": "#000000",
    "alignment": "JUSTIFY",
    "line_spacing": 1.15,
    "first_line_indent": 0.25,
    "indent_unit": "inch"
  },
  "elements": {
    "TITLE": {
      "font": "Times New Roman",
      "font_size": 18.0,
      "font_size_unit": "pt",
      "bold": true,
      "italic": false,
      "alignment": "CENTER",
      "space_before": 12,
      "space_after": 8
    },
    "AUTHOR": {
      "font": "Times New Roman",
      "font_size": 11.0,
      "font_size_unit": "pt",
      "bold": false,
      "italic": false,
      "alignment": "CENTER",
      "space_before": 4,
      "space_after": 2
    },
    "AFFILIATION": {
      "font": "Times New Roman",
      "font_size": 9.5,
      "font_size_unit": "pt",
      "bold": false,
      "italic": true,
      "alignment": "CENTER",
      "space_before": 0,
      "space_after": 14
    },
    "ABSTRACT": {
      "font": "Times New Roman",
      "font_size": 10.0,
      "font_size_unit": "pt",
      "alignment": "JUSTIFY",
      "line_spacing": 1.15,
      "space_before": 10,
      "space_after": 10,
      "first_line_indent": 0.0,
      "left_indent": 0.5,
      "right_indent": 0.5,
      "indent_unit": "inch"
    },
    "KEYWORDS": {
      "font": "Times New Roman",
      "font_size": 10.0,
      "font_size_unit": "pt",
      "italic": true,
      "alignment": "JUSTIFY",
      "space_before": 0,
      "space_after": 14,
      "left_indent": 0.5,
      "right_indent": 0.5,
      "indent_unit": "inch"
    },
    "HEADING_1": {
      "font": "Times New Roman",
      "font_size": 12.0,
      "font_size_unit": "pt",
      "bold": true,
      "alignment": "LEFT",
      "space_before": 12,
      "space_after": 6
    },
    "HEADING_2": {
      "font": "Times New Roman",
      "font_size": 11.0,
      "font_size_unit": "pt",
      "bold": true,
      "alignment": "LEFT",
      "space_before": 9,
      "space_after": 4
    },
    "HEADING_3": {
      "font": "Times New Roman",
      "font_size": 10.5,
      "font_size_unit": "pt",
      "bold": true,
      "italic": true,
      "alignment": "LEFT",
      "space_before": 6,
      "space_after": 3
    },
    "BODY": {
      "font": "Times New Roman",
      "font_size": 11.0,
      "font_size_unit": "pt",
      "alignment": "JUSTIFY",
      "line_spacing": 1.15,
      "first_line_indent": 0.25,
      "indent_unit": "inch",
      "space_before": 0,
      "space_after": 0
    },
    "TABLE": {
      "font": "Times New Roman",
      "font_size": 10.0,
      "font_size_unit": "pt",
      "alignment": "CENTER"
    },
    "CAPTION": {
      "font": "Times New Roman",
      "font_size": 9.5,
      "font_size_unit": "pt",
      "bold": true,
      "alignment": "CENTER",
      "space_before": 10,
      "space_after": 4
    },
    "REFERENCE": {
      "font": "Times New Roman",
      "font_size": 9.5,
      "font_size_unit": "pt",
      "alignment": "LEFT",
      "line_spacing": 1.05,
      "hanging_indent": 0.25,
      "indent_unit": "inch",
      "space_after": 4
    }
  },
  "validation": {
    "check_page_layout": true,
    "check_columns": true,
    "check_font": true,
    "check_font_size": true,
    "check_alignment": true,
    "check_line_spacing": true,
    "check_indentation": true,
    "check_heading_styles": true,
    "check_tables": true,
    "check_captions": true,
    "check_references": true
  }
}
